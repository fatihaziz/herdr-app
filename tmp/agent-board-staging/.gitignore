# Generated OMP plugin cache state: hardcodes absolute machine-local paths under
# the current user's home directory, and carries install timestamps that churn on
# every plugin update. omp-plugins.lock.json beside them IS tracked deliberately,
# because it holds no machine-local paths.
.fatih-agentic/omp/marketplaces.json
.fatih-agentic/omp/plugins/installed_plugins.json

